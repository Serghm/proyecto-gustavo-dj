generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  telefono  String
  correo    String
  servicio  String?  // <-- Le agregamos el "?"
  fecha     String?  // <-- Le agregamos el "?"
  hora      String?  // <-- Le agregamos el "?"
  ubicacion String?  // <-- Le agregamos el "?"
  detalles  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}